# CyberShield Environment Configuration
FLASK_APP=cybershield.app:create_app
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production-cybershield-2026
DATABASE_URL=sqlite:///cybershield.db
UPLOAD_FOLDER=instance/uploads
MAX_CONTENT_LENGTH=16777216

# Network Security Lab Configuration
# Authorized target list (comma separated). Default is localhost only for safety.
ALLOWED_SCAN_TARGETS=127.0.0.1,localhost,::1

# Subprocess timeouts in seconds
NMAP_TIMEOUT_SECONDS=45
SNORT_TIMEOUT_SECONDS=30
